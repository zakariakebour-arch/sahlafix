# URL base de la API (cambia según tu entorno)
VITE_APP_API_URL=http://localhost:5000/api/v1

# Modo de ejecución (development o production)
VITE_APP_ENV=development

# Token de autenticación inicial (si tu backend usa JWT)
VITE_APP_API_TOKEN=

# Timeout por defecto para las peticiones HTTP en milisegundos
VITE_APP_API_TIMEOUT=5000

# URL de servicios externos o imágenes (opcional)
VITE_APP_ASSETS_URL=http://localhost:5000/assets